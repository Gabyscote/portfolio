---
// L'image principale d'un projet, dans le cadre qui lui va :
// « affiche » (une affiche posée), « navigateur » (une capture de site), « libre » (telle quelle).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  cadre?: 'affiche' | 'navigateur' | 'libre';
  sizes?: string;
  eager?: boolean;
}

const { src, alt, sizes = '(min-width: 64rem) 40rem, 100vw', eager = false } = Astro.props;
const cadre = Astro.props.cadre ?? (src.height > src.width ? 'affiche' : 'libre');
---

<div class:list={['couv', `couv--${cadre}`]}>
  {
    cadre === 'navigateur' && (
      <span class="navigateur__barre" aria-hidden="true">
        <i />
        <i />
        <i />
      </span>
    )
  }
  <Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
</div>
